# Copy to .env and fill in. NEVER commit .env.
# Database (docker-compose defaults)
DB_NAME=repolens
DB_USERNAME=repolens
# Leave empty for local Compose fallback (repolens); production requires a real value
DB_PASSWORD=
DB_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/repolens

# Application
SERVER_PORT=8081

# Optional GitHub token: raises the API rate limit during ingestion.
GITHUB_TOKEN=

# Embeddings (local ONNX, no key needed). First run downloads ~90 MB.
EMBEDDING_PROVIDER=transformers
EMBEDDING_CACHE_DIR=
# EMBEDDING_MODEL_URI=https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/resolve/main/onnx/model.onnx
# EMBEDDING_TOKENIZER_URI=https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/raw/main/tokenizer.json

# Ingestion
GITHUB_ISSUES_ENABLED=true

# LLM. Default is "fake" (no key, deterministic, used by tests/load tests).
# Any OpenAI-compatible /chat/completions endpoint works: OpenAI, OpenRouter, Groq, vLLM, LM Studio, Ollama (/v1).
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
# Optional: simulate latency for the fake provider during load tests
LLM_FAKE_LATENCY=0ms
# Groq example:
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_TOKENS=2048
# LLM_API_KEY=<groq key>

# Local Ollama example:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# API key required by /api/* and /mcp. Generate a random value, e.g. openssl rand -hex 32.
REPOLENS_API_KEY=
REPOLENS_API_KEY_REQUIRED=true

# Database pool and auth cache
DB_POOL_SIZE=20
DB_MIN_IDLE=5
VECTOR_POOL_SIZE=10
REPOLENS_API_KEY_CACHE_TTL=60s

# Rate limiting (per key, IP fallback). Separate ask/search/general buckets.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_CAPACITY=10
RATE_LIMIT_ASK_REFILL=0.5
RATE_LIMIT_SEARCH_CAPACITY=30
RATE_LIMIT_SEARCH_REFILL=5
RATE_LIMIT_GENERAL_CAPACITY=60
RATE_LIMIT_GENERAL_REFILL=10

# Observability stack
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
# Required for anything beyond localhost; local fallback is local-dev-only-change-me
GRAFANA_PASSWORD=

# Production deployment (deploy/docker-compose.prod.yml)
DOMAIN=
REPOLENS_IMAGE=ghcr.io/OWNER/repolens:0.1.0
