[0.687, "o", "[\r\n    {\r\n        \"chunkId\": 7,\r\n        \"documentId\": 3,\r\n        \"kind\": \"README\",\r\n        \"pathOrRef\": \"README.md\",\r\n        \"url\": \"https://github.com/encode/httpx/blob/master/README.md\",\r\n        \"title\": \"README.md\",\r\n        \"headingPath\": \"Installation\",\r\n        \"snippet\": \"Install with pip: ```shell $ pip install httpx ``` Or, to include the optional HTTP/2 support, use: ```shell $ pip install httpx[http2] ``` HTTPX requires Python 3.9+.\",\r\n        \"score\": 0.03225806451612903,\r\n        \"vectorRank\": 2,\r\n        \"keywordRank\": 2\r\n    },\r\n    {\r\n        \"chunkId\": 141,\r\n        \"documentId\": 15,\r\n        \"kind\": \"DOC\",\r\n        \"pathOrRef\": \"docs/index.md\",\r\n        \"url\": \"https://github.com/encode/httpx/blob/master/docs/index.md\",\r\n        \"title\": \"index.md\",\r\n        \"headingPath\": \"Installation\",\r\n        \"snippet\": \"Install with pip: ```shell $ pip install httpx ``` Or, to include the optional HTTP/2 support, use: ```shell $ pip install httpx[http2] ``` To include the optional brotli and zstandard decoders support, use: ```shell $ pip install httpx[brotli,zstd] ``` HTTPX requires Python 3.9+ [sync-support]: https://github.com/encode/httpx/issues/572\",\r\n        \"score\": 0.03047794966520434,\r\n        \"vectorRank\": 11,\r\n        \"keywordRank\": 1\r\n    },\r\n    {\r\n        \"chunkId\": 294,\r\n        \"documentId\": 5,\r\n        \"kind\": \"DOC\",\r\n        \"pathOrRef\": \"CHANGELOG.md\",\r\n        \"url\": \"https://github.com/encode/httpx/blob/master/CHANGELOG.md\",\r\n        \"title\": \"CHANGELOG.md\",\r\n        \"headingPath\": \"Changelog > 0.13.0.dev2 (May 12th, 2020)\",\r\n        \"snippet\": \"The 0.13.0.dev2 is a *pre-release* version. To install it, use `pip install httpx --pre`.\",\r\n        \"score\": 0.029957522915269395,\r\n        \"vectorRank\": 3,\r\n        \"keywordRank\": 11\r\n    }\r\n]\r\n"]
